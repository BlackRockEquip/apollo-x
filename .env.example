DATABASE_URL="postgresql://apollo:change-me@localhost:5432/apollo_x?schema=public"
DATABASE_URL_TEST="postgresql://apollo:change-me@localhost:5432/apollo_x_test?schema=public"
SESSION_COOKIE_SECURE="false"
BOOTSTRAP_PLATFORM_EMAIL="platform-admin@example.com"
BOOTSTRAP_PLATFORM_PASSWORD="replace-before-seeding"

# Workshop WIP Excel auto-sync (optional) — see src/lib/jobs/excel-sync.ts.
# Two ways to run this, depending on where Apollo X itself is running:
#
#  1. Local dev (Apollo X running on this same machine): src/instrumentation.ts
#     starts an in-process watcher automatically when both JOBS_SYNC_FILE_PATH
#     and JOBS_SYNC_COMPANY_NAME are set below, in THIS .env file. Nothing
#     else needed.
#  2. Apollo X deployed to Render (this machine only has the workbook, not
#     the server): run `npm run excel-sync:bridge` on this machine instead —
#     see scripts/excel-sync-bridge.ts. It reads the same JOBS_SYNC_* vars
#     from this same .env file, plus the two EXCEL_SYNC_* vars below, and
#     pushes the file to the deployed app over HTTPS. Leave
#     JOBS_SYNC_FILE_PATH unset on the Render server itself (it has no
#     access to this file anyway) — that's what keeps
#     src/instrumentation.ts's in-process watcher correctly disabled there.
#
# JOBS_SYNC_FILE_PATH is a local path to the live WIP workbook (e.g. into a
# OneDrive-synced folder on this machine). JOBS_SYNC_COMPANY_NAME matches a
# company's Legal name or Trading name exactly (case-insensitive).
JOBS_SYNC_FILE_PATH=""
JOBS_SYNC_COMPANY_NAME=""
# Set to "true" only if changes to the file aren't being detected (this can
# happen through OneDrive's Files On-Demand virtual filesystem) — falls
# back to polling instead of native file-change events. Read by both the
# in-process watcher and the bridge script.
JOBS_SYNC_USE_POLLING="false"
# Required only for the bridge script (npm run excel-sync:bridge), NOT for
# the in-process watcher. EXCEL_SYNC_API_KEY is a shared secret: set the
# SAME value here and on the deployed Render server's own environment
# variables (see render.yaml / the Render dashboard) — generate one with
# `openssl rand -hex 32` or similar. EXCEL_SYNC_TARGET_URL is the deployed
# app's base URL (e.g. the Render staging URL); the bridge script posts to
# "${EXCEL_SYNC_TARGET_URL}/api/v1/integrations/excel-sync".
EXCEL_SYNC_API_KEY=""
EXCEL_SYNC_TARGET_URL=""

# Object storage — platform-wide default bucket (see
# claude/decision-storage-architecture-render-plus-object-storage.md and
# src/lib/storage/index.ts). Used for any company that hasn't been given
# its own override on Platform > Companies > [company] > Storage location.
# Leave all four blank to fall back to local-disk storage — allowed in
# development only; production with nothing configured throws
# STORAGE_NOT_CONFIGURED rather than silently writing to local disk.
# STORAGE_PROVIDER_DEFAULT is "R2" | "B2" | "S3_COMPATIBLE".
STORAGE_PROVIDER_DEFAULT=""
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
# Required for R2/B2/MinIO (their own account-specific S3-compatible
# endpoint URL); leave blank only for real AWS S3.
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
