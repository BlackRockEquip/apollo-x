# This file is a TEMPLATE — it is tracked in git (see .gitignore's
# `!.env.example` line) and gets pushed to GitHub with every commit that
# touches it. NEVER put a real password, API key, or secret in here. Real
# values belong only in your own local `.env` (gitignored, never committed)
# or in the Render dashboard's env var fields. If a real secret ever does
# end up in this file and gets pushed, treat it as compromised — rotate/
# regenerate it at the provider (Cloudflare/Backblaze/etc.), don't just
# remove it from the file, since it stays in git history either way.

DATABASE_URL="postgresql://apollo:change-me@localhost:5432/apollo_x?schema=public"
DATABASE_URL_TEST="postgresql://apollo:change-me@localhost:5432/apollo_x_test?schema=public"
SESSION_COOKIE_SECURE="false"
BOOTSTRAP_PLATFORM_EMAIL="platform-admin@example.com"
BOOTSTRAP_PLATFORM_PASSWORD="replace-before-seeding"

# Object storage — platform-wide default bucket (see
# claude/decision-storage-architecture-render-plus-object-storage.md and
# src/lib/storage/index.ts). Used for any company that hasn't been given
# its own override on Platform > Companies > [company] > Storage location.
# Leave all four blank to fall back to local-disk storage — allowed in
# development only; production with nothing configured throws
# STORAGE_NOT_CONFIGURED rather than silently writing to local disk.
# STORAGE_PROVIDER_DEFAULT is "R2" | "B2" | "S3_COMPATIBLE".
STORAGE_PROVIDER_DEFAULT=""
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
# Required for R2/B2/MinIO (their own account-specific S3-compatible
# endpoint URL); leave blank only for real AWS S3. This is the ACCOUNT
# endpoint only — do NOT append the bucket name to it (e.g. for R2:
# "https://<account-id>.r2.cloudflarestorage.com", nothing after it). The
# S3 SDK adds the bucket itself; if it's already in the endpoint too,
# requests end up looking for "<bucket>/<bucket>/..." and 404.
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# Optional: secret used to sign download links for the "Local folder" storage
# option. If unset, one is derived from DATABASE_URL (stable across restarts).
STORAGE_SIGNING_SECRET=""

# Recommended in production: a long random string (e.g. `openssl rand -base64 48`)
# used to encrypt each company's storage secret access key in the database.
# If unset, a key derived from DATABASE_URL is used. Changing this (or
# DATABASE_URL) later makes saved secrets unreadable: re-enter them in
# Platform > Companies > [company] > Storage location.
STORAGE_ENCRYPTION_KEY=""
