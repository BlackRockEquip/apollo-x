// Replaces the old JobPartRequirement/JobPartAllocation/JobPartAllocationMovement
// reserve-issue-return workflow (removed 2026-09-09 at the user's request —
// "the parts required section in apollo should be removed and the parts
// list section in modapp should be added"). Mirrors ModApp's JobPartLine: a
// simple, directly-editable list of parts needed for a job — paste a list,
// track order number/supplier, mark quantities received — rather than a
// formal reserve/issue/return chain through the immutable inventory ledger.
// `partId` is an optional cross-check link to Apollo X's own Part catalog
// (set automatically when a pasted part number matches one on file, same as
// ModApp's inventoryItemId); `partNumber` itself stays free text so a line
// for a part not yet in the catalog can still be recorded.
model JobPartLine {
  id                    String          @id @default(cuid())
  companyId             String
  jobId                 String
  partNumber            String
  description           String?
  quantity              Decimal         @db.Decimal(19, 4)
  status                PartLineStatus  @default(PENDING)
  // How many have actually been confirmed received so far — a delivery
  // doesn't always match the ordered quantity exactly, and this
  // accumulates across multiple "mark received" clicks rather than
  // locking the line after the first partial delivery.
  receivedQuantity      Decimal?        @db.Decimal(19, 4)
  // Whatever status this line was in right before receiving started —
  // restored exactly by "Undo" if "Mark received" was clicked by mistake.
  previousStatus        PartLineStatus?
  orderNumber           String?
  orderedFromSupplierId String?
  orderedAt             DateTime?
  partId                String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                   Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part                  Part?           @relation(fields: [partId], references: [id], onDelete: SetNull)
  orderedFromSupplier    Supplier?      @relation("JobPartLineOrderedFromSupplier", fields: [orderedFromSupplierId], references: [id], onDelete: SetNull)
  createdBy              UserIdentity?  @relation("JobPartLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              UserIdentity?  @relation("JobPartLineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
  @@index([companyId, partId])
  @@index([companyId, orderedFromSupplierId])
}

// New — added 2026-09-09 alongside the JobPartLine change above, at the
// user's request ("The outwork section from modapp should also be added to
// apollo"). Mirrors ModApp's OutworkItem: components sent out to a supplier
// for outwork (machining, sandblasting, plating, etc.) and tracked until
// they come back. Deliberately simpler than ModApp's version — no
// printable delivery-note generation, since Apollo X doesn't have ModApp's
// document-branding/print-template subsystem yet.
model OutworkItem {
  id            String        @id @default(cuid())
  companyId     String
  jobId         String
  supplierId    String
  description   String
  quantity      Int           @default(1)
  status        OutworkStatus @default(SENT_OUT)
  dateSentOut   DateTime?
  dateReceived  DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation("OutworkItemSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     UserIdentity? @relation("OutworkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     UserIdentity? @relation("OutworkItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
  @@index([companyId, supplierId])
  @@index([companyId, status])
}

model JobNote {
  id          String       @id @default(cuid())
  companyId   String
  jobId       String
  note        String
  createdById String
  createdAt   DateTime     @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy   UserIdentity @relation("JobNoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, createdAt])
}

model JobActivity {
  id          String          @id @default(cuid())
  companyId   String
  jobId       String
  type        JobActivityType
  description String
  metadata    Json?
  actorId     String?
  createdAt   DateTime        @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor       UserIdentity?   @relation("JobActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId, createdAt])
}

model JobFieldServiceReport {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String   @unique
  site        String?
  technician  String?
  vehicle     String?
  hours       Decimal? @db.Decimal(19, 4)
  report      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId])
}

model JobWarranty {
  id                     String            @id @default(cuid())
  companyId              String
  jobId                  String            @unique
  status                 JobWarrantyStatus
  notes                  String?
  historicalSourceStatus String?
  updatedById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                    Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId])
}

enum ModuleCatalogStatus {
  ACTIVE
  INACTIVE
  PLANNED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TicketMessageKind {
  REPLY
  INTERNAL_NOTE
}

model ModuleCatalogEntry {
  id                  String              @id @default(cuid())
  code                String              @unique
  moduleKey           ModuleKey?          @unique
  name                String
  description         String?
  category            String
  status              ModuleCatalogStatus @default(ACTIVE)
  version             String              @default("1.0.0")
  icon                String?
  navGroup            String?
  navOrder            Int?
  route               String?
  assignableToTenants Boolean             @default(false)
  userAssignable      Boolean             @default(true)
  dependsOn           ModuleKey[]
  licensingMetadata   Json?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  createdBy UserIdentity? @relation("ModuleCatalogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, status])
}

model PlatformSequence {
  key       String   @id
  nextValue BigInt   @default(1)
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id                String         @id @default(cuid())
  companyId         String
  ticketNumber      String         @unique
  subject           String
  description       String
  category          String?
  priority          TicketPriority @default(NORMAL)
  status            TicketStatus   @default(OPEN)
  moduleKey         ModuleKey?
  pageRoute         String?
  userAgent         String?
  appVersion        String?
  reportedById      String
  assignedSupportId String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reportedBy      UserIdentity  @relation("TicketReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedSupport UserIdentity? @relation("TicketAssignedSupport", fields: [assignedSupportId], references: [id], onDelete: SetNull)

  messages    SupportTicketMessage[]
  events      SupportTicketEvent[]
  attachments SupportTicketAttachment[]

  @@index([companyId, status, priority])
  @@index([status, priority, createdAt])
  @@index([assignedSupportId, status])
  @@index([createdAt])
}

model SupportTicketMessage {
  id        String            @id @default(cuid())
  companyId String
  ticketId  String
  authorId  String
  kind      TicketMessageKind
  body      String
  createdAt DateTime          @default(now())

  ticket      SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      UserIdentity               @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
}

model SupportTicketEvent {
  id        String   @id @default(cuid())
  companyId String
  ticketId  String
  actorId   String?
  eventType String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  UserIdentity? @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SupportTicketAttachment {
  id           String   @id @default(cuid())
  companyId    String
  ticketId     String
  messageId    String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  ticket     SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy UserIdentity?         @relation("TicketAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model UserDashboardConfig {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}
