// One flat status list shared across every job type, same pattern ModApp
// uses (JobStatus there) — which subset/order is valid for a given job is
// a pure function of JobType, computed in application code (see
// src/lib/jobs/ui.ts's flow-family step lists), not a stored column. This
// enum is additive-only relative to Apollo X's original 13 values (kept
// exactly as they were, including their names) — the new values below fill
// in the granularity ModApp's real-world use surfaced that Apollo X didn't
// have yet: a pre-strip queue state, outwork/paint stages, a payment-wait
// state distinct per flow, three dedicated field-service stages, two
// dedicated parts-supply stages, and the reversible "quoted, client
// declined, returned unrepaired" off-ramp.
enum JobStatus {
  DRAFT
  TO_BE_COLLECTED
  TO_BE_RECEIVED
  // Queued for stripping, after receipt but before STRIPPING actually
  // starts — main workshop flow only.
  TO_STRIP
  STRIPPING
  QUOTE_IN_PROGRESS
  AWAITING_GO_AHEAD
  // Waiting on an external supplier/outwork task (e.g. machining,
  // sandblasting sent out) — main workshop flow only, distinct from
  // WAITING_FOR_PARTS (internal inventory).
  AWAIT_OUTWORK
  WAITING_FOR_PARTS
  ASSEMBLY
  TESTING
  // Paint / wrap finishing stage — main workshop flow only.
  TO_PAINT_WRAP
  TO_BE_DELIVERED
  // Delivered, payment still outstanding — main/parts-supply flows.
  // Field-service jobs use AWAIT_PAYMENT below instead (kept as a
  // separate value, matching ModApp's own flow-specific split).
  DELIVERED_AWAITING_PAYMENT
  COMPLETE
  CLOSED
  CANCELLED
  // Quoted, client declined and asked for the unit back unrepaired.
  // Deliberately not part of any flow's ordered step list (it can happen
  // from several earlier stages, most commonly AWAITING_GO_AHEAD, and
  // skips everything after it) — reversible back to AWAITING_GO_AHEAD if
  // the client changes their mind. Main workshop flow only.
  RETURNED_UNREPAIRED

  // --- Field service flow only ---
  TO_ATTEND
  ON_ROUTE
  IN_PROGRESS
  AWAIT_PAYMENT

  // --- Parts supply flow only (alongside the shared TO_BE_RECEIVED /
  // TO_BE_DELIVERED / DELIVERED_AWAITING_PAYMENT / COMPLETE above) ---
  RECEIVED
  INSPECTING
}

