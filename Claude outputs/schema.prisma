  supplierId      String
  type            AddressType
  label           String?
  line1           String
  line2           String?
  city            String?
  province        String?
  postalCode      String?
  countryCode     String      @default("ZA")
  isPrimary       Boolean     @default(false)
  active          Boolean     @default(true)
  deactivatedAt   DateTime?
