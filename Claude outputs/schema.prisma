  PART_LINE_RECEIVED
  PART_LINE_RECEIVED_UNDONE
  PART_LINE_ORDER_UPDATED
  OUTWORK_SENT
  OUTWORK_RECEIVED
  OUTWORK_RECEIVED_UNDONE
  OUTWORK_EDITED
  OUTWORK_DELETED
  PEX_STOCK_TRANSFERRED
  PEX_STOCK_LINKED
  PEX_STOCK_UNLINKED
  PEX_RETURN_AUTO_CREATED
  PEX_RETURN_REGISTERED
  PEX_RETURN_RECEIVED
  PEX_RETURN_RELINKED
  PEX_SUPPLY_CANCELLED
  PEX_RETURN_CLOSED_WITHOUT_CORE
  PEX_STOCK_STATUS_CHANGED
  NOTE_ADDED
  FIELD_SERVICE_UPDATED
