  parts          Part[]
  suppliers      SupplierManufacturer[]

  @@unique([companyId, nameNormalized])
  @@unique([companyId, codeNormalized])
  @@index([companyId, active])
}

model SupplierManufacturer {
  id              String       @id @default(cuid())
