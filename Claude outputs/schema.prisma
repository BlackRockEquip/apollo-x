// Hybrid job-type model (see the platform merge plan doc): JobType stays a
// fixed enum because it drives real behavior (which status-flow family a
// job follows, which ModuleKey gates it — see the flow-family logic in
// src/lib/jobs/ui.ts) — that's deliberately NOT customizable. What IS
// customizable, matching ModApp's per-company JobTypeConfig, is the label a
// company sees and picks from: a JobTypePreset is a company's own named
// preset (e.g. "Sandblasting", "Hydraulic Rebuild") that declares which
// fixed JobType it behaves as. Selecting a preset in the UI sets Job.type
// to `behavesAs`; the preset's own label is just how it's shown and
// searched in that company's job-type picker.
model JobTypePreset {
  id        String   @id @default(cuid())
  companyId String
  key       String
  label     String
  behavesAs JobType
  active    Boolean  @default(true)
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId, active])
}

// Matches ModApp's PurchaseOrderStatus exactly (field parity pass, see the
// platform merge plan doc) — used on Job.purchaseOrderStatus below.
enum PurchaseOrderStatus {
  TBA
  AWAIT_PAYMENT
  PARTIALLY_PAID
  PAID
  NOT_APPLICABLE
}

// Matches ModApp's DeliveryType exactly — used for both legs of a job's
// transport (Job.deliveryType for the outbound/return leg,
// Job.receivingTransport for how the unit originally arrived).
enum DeliveryType {
  INTERNAL_BAKKIE
  INTERNAL_TRUCK
  INTERNAL_COURIER
  EXTERNAL_BAKKIE
  EXTERNAL_TRUCK
  EXTERNAL_COURIER
}

model Job {
  id                  String      @id @default(cuid())
  companyId           String
  jobNumber           String?     @unique
  draftNumber         String      @unique @default(cuid())
  status              JobStatus   @default(DRAFT)
  type                JobType
  customerId          String
  customerReference   String?
  customerPo          String?
  dateReceived        DateTime?
  machineMake         String?
  machineModel        String?
  machineSerial       String?
  component           String?
  componentType       String?
  componentSerial     String?
  componentPartNumber String?
  description         String?
  etaDate             DateTime?
  // Staff-only ETA a mechanic sets for their own planning, distinct from
  // the client-facing etaDate above — visible/editable only to
  // Company Admin / Manager (mirrors ModApp's canEditMechanicEta gate).
  mechanicEtaDate     DateTime?
  relationshipNotes   String?
  relatedJobId        String?
  stripMechanicId     String?
  buildMechanicId     String?
  closingOutcome      String?
  closingNote         String?
  closedAt            DateTime?
  closedById          String?
  createdById         String
  updatedById         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // --- Field-parity additions (matching ModApp's Job model) ---
  // Quote / sales-order / invoice / purchase-order references. Plain
  // string/date fields for now, same as ModApp — become proper foreign
  // keys once the Quotes/Sales Orders/Invoices modules (still unbuilt,
  // see ModuleKey) exist.
  quoteNumber          String?
  quoteDate            DateTime?
  salesOrderNumber     String?
  salesOrderDate       DateTime?
  invoiceNumber        String?
  invoiceDate          DateTime?
  purchaseOrderNumber  String?
  purchaseOrderDate    DateTime?
  purchaseOrderStatus  PurchaseOrderStatus @default(NOT_APPLICABLE)
  // Two independent transport legs — how the unit arrived vs. how it goes
  // back out — matching ModApp's separate receivingTransport/deliveryType.
  deliveryDate         DateTime?
  deliveryType         DeliveryType?
  receivingTransport   DeliveryType?
  // Field-service-only: how far the technician travelled to/from site.
  kmsTravelled         Int?
  paymentDateReceived  DateTime?
  // Ticked when no payment is required at all for this job (e.g. a
  // no-charge warranty repair) — lets a "payment received" guard be
  // satisfied without a real date, distinguishable from "not paid yet".
  paymentNotApplicable Boolean   @default(false)
  machineHours         Decimal?  @db.Decimal(19, 4)
  plantNumber          String?
  reportNumber         String?
  importTrackingNumber String?
  // Free-text link to a prior job number (e.g. a "ready to go" PEX unit
  // being redeployed) — kept as a plain field for traceability and for
  // the historical-data import, even though Apollo X's own PEX linking
  // (PexStockUnit/PexSupplyLink) is the structured, authoritative version.
  previousJobNumber    String?
  salesRepresentative  String?

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  relatedJob          Job?          @relation("RelatedJob", fields: [relatedJobId], references: [id], onDelete: SetNull)
  relatedJobs         Job[]         @relation("RelatedJob")
  stripMechanic       UserIdentity? @relation("JobStripMechanic", fields: [stripMechanicId], references: [id], onDelete: SetNull)
  buildMechanic       UserIdentity? @relation("JobBuildMechanic", fields: [buildMechanicId], references: [id], onDelete: SetNull)
  createdBy           UserIdentity  @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           UserIdentity  @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  closedBy            UserIdentity? @relation("JobClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  components          JobComponent[]
  partLines           JobPartLine[]
  outworkItems        OutworkItem[]
  notes               JobNote[]
  activities          JobActivity[]
  fieldServiceReport  JobFieldServiceReport?
  warranty            JobWarranty?
  pexSourceStockUnits PexStockUnit[]          @relation("PexStockSourceJob")
  pexSupplyStockUnits PexStockUnit[]          @relation("PexStockCurrentSupplyJob")
  pexReturnStockUnits PexStockUnit[]          @relation("PexStockCurrentReturnJob")
  pexSupplyLinksAsSupply PexSupplyLink[]      @relation("PexSupplyJob")
  pexSupplyLinksAsReturn PexSupplyLink[]      @relation("PexReturnJob")

  @@unique([id, companyId])
  @@index([companyId, status, createdAt])
  @@index([companyId, type, createdAt])
  @@index([companyId, customerId, createdAt])
}

