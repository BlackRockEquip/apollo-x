// The platform hosts more than one product line under one shared
// identity/entitlement/support layer (see the platform merge plan doc) —
// today only WORKSHOP has real modules built against it. SPORTS_LEAGUE is
// reserved for the future Sports League product (ported from Ringball)
// so the entitlement schema doesn't need another breaking migration when
// that track starts. Every ModuleKey value above is a WORKSHOP module;
// Sports League will get its own module keys when that work begins.
enum Product {
  WORKSHOP
  SPORTS_LEAGUE
}

