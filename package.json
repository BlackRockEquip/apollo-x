{
  "name": "apollo-x-working",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "npx next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "tsx prisma/seed.ts",
    "excel-sync:bridge": "tsx scripts/excel-sync-bridge.ts",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-db.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-db.ps1",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-db.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@prisma/client": "5.22.0",
    "argon2": "^0.44.0",
    "chokidar": "^4.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pdf-parse": "^1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.1",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
