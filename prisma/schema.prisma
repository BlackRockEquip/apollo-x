  status                 TenantStatus @default(ACTIVE)
  defaultCurrencyCode    String       @default("ZAR")
  defaultGracePeriodDays Int          @default(30)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  memberships       CompanyMembership[]
  products          CompanyProduct[]
  jobTypePresets    JobTypePreset[]
  entitlements      CompanyModuleEntitlement[]
  entitlementEvents EntitlementHistory[]
  supportAccess     PlatformSupportAccess[]
  auditEvents       AuditEvent[]
  settings          CompanySettings?
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  stockCounts       StockCount[]
  addresses         CompanyAddress[]
  customers         Customer[]
  customerBranches  CustomerBranch[]
  customerContacts  CustomerContact[]
  customerAddresses CustomerAddress[]
  suppliers         Supplier[]
  supplierContacts  SupplierContact[]
  supplierAddresses SupplierAddress[]
  manufacturers     Manufacturer[]
  supplierBrands    SupplierManufacturer[]
  parts             Part[]
  storageLocations  StorageLocation[]
  serviceItems      ServiceItem[]
  taxCodes          TaxCode[]
  commercialTerms   CommercialTerm[]
  documentSequences DocumentNumberSequence[]
  jobs              Job[]
  jobComponents     JobComponent[]
  jobKits           JobKit[]
  jobKitLines       JobKitLine[]
  jobPartLines      JobPartLine[]
  outworkItems      OutworkItem[]
  pickSlips         PickSlip[]
  rfqRequests       JobRfqRequest[]
  generalRfqRequests GeneralRfqRequest[]
  jobAttachments    JobAttachment[]
  attachments       Attachment[]
  jobNotes          JobNote[]
  jobActivities     JobActivity[]
  jobFieldServiceReports JobFieldServiceReport[]
  jobWarranties     JobWarranty[]
  pexRecords        PexRecord[]
  supportTickets    SupportTicket[]
  dashboardConfigs  UserDashboardConfig[]
  tableColumnConfigs UserTableColumns[]
}

// The top-level subscription record: which Product(s) an organization is
// granted access to at all, separate from and above CompanyModuleEntitlement
// (which gates individual modules *within* a subscribed product). A company
// with no CompanyProduct row for a given Product should be treated as not
// subscribed to it, regardless of any module entitlement rows that might
// exist. Every existing/current company is WORKSHOP-only; SPORTS_LEAGUE
// subscriptions start appearing once that product track is built.
model CompanyProduct {
  id            String            @id @default(cuid())
  companyId     String
  product       Product
  status        EntitlementStatus
  effectiveFrom DateTime          @default(now())
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, product])
  @@index([companyId, status])
}

model CompanyMembership {
  id        String           @id @default(cuid())
  userId    String
  companyId String
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user        UserIdentity           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions MembershipPermission[]
  sessions    UserSession[]

  @@unique([userId, companyId])
  @@index([companyId, status])
}

model MembershipPermission {
  id           String  @id @default(cuid())
  membershipId String
  permission   String
  allowed      Boolean

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
}

model PlatformRoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user        UserIdentity         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions PlatformPermission[]

  @@unique([userId, role])
}

model PlatformPermission {
  id           String  @id @default(cuid())
  assignmentId String
  permission   String
  allowed      Boolean

  assignment PlatformRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, permission])
}

model PlatformSupportAccess {
  id         String            @id @default(cuid())
  operatorId String
  companyId  String
  mode       SupportAccessMode
  reason     String
  startedAt  DateTime          @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
  endedById  String?

  operator UserIdentity  @relation("SupportInitiator", fields: [operatorId], references: [id])
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  endedBy  UserIdentity? @relation("SupportEnder", fields: [endedById], references: [id])
  sessions UserSession[]

  @@index([operatorId, expiresAt])
  @@index([companyId, expiresAt])
}

model UserSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  userId          String
  membershipId    String?
  supportAccessId String?
  sessionVersion  Int
  expiresAt       DateTime
  revokedAt       DateTime?
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  user          UserIdentity           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership    CompanyMembership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  supportAccess PlatformSupportAccess? @relation(fields: [supportAccessId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginThrottle {
  keyHash      String    @id
  attemptCount Int       @default(0)
  windowStart  DateTime  @default(now())
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([lockedUntil])
}

model CompanyModuleEntitlement {
  id                    String            @id @default(cuid())
  companyId             String
  product               Product           @default(WORKSHOP)
  module                ModuleKey
  source                EntitlementSource
  status                EntitlementStatus
  effectiveFrom         DateTime
  expiresAt             DateTime?
  gracePeriodDays       Int?
  readOnlyOverrideUntil DateTime?
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, product, module])
  @@index([companyId, product, status])
}

model EntitlementHistory {
  id             String             @id @default(cuid())
  companyId      String
  product        Product            @default(WORKSHOP)
  module         ModuleKey
  previousStatus EntitlementStatus?
  newStatus      EntitlementStatus
  source         EntitlementSource
  effectiveAt    DateTime
  expiresAt      DateTime?
  reason         String?
  changedById    String?
  createdAt      DateTime           @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, product, module, createdAt])
}

model CompanySettings {
  id                     String  @id @default(cuid())
  companyId              String  @unique
  defaultCurrencyCode    String  @default("ZAR")
  defaultTaxJurisdiction String  @default("ZA")
  themeColor             String?
  logoObjectKey          String?
  registrationNumber     String?
  vatNumber              String?
  mainTelephone          String?
  mainEmail              String?
  website                String?
  defaultTaxCodeId       String?
  defaultPaymentTermId   String?
  quoteValidityDays      Int     @default(30)
  documentHeaderText     String?
  documentFooterText     String?
  accentColor            String?
  secondaryColor         String?
  logoData               Bytes?
  logoMimeType           String?
  logoFileName           String?
  logoSizeBytes          Int?
  logoUpdatedAt          DateTime?

  // Per-company outbound email (SMTP) — added 2026-09-09 at the user's
  // request to wire real RFQ-request emails, mirroring ModApp's
  // per-company SMTP settings (isCompanyEmailConfigured/sendEmail in
  // lib/email.ts there). smtpPassword is written but never read back to
  // the client — see company-settings-service.ts's getCompanySettings.
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean @default(true)
  smtpUsername           String?
  smtpPassword           String?
  smtpFromAddress        String?
  smtpFromName           String?
  smtpConfiguredAt       DateTime?

  // Per-company file-storage override — added 2026-09-14, Super Admin
  // (Platform > Companies > [company]) setting only, not editable by the
  // company's own Company Admin. Null storageProvider means "use the
  // platform-wide default bucket" (STORAGE_* env vars — see
  // src/lib/storage/index.ts). storageSecretAccessKey is write-only, same
  // convention as smtpPassword above: never returned to any client, and an
  // update with it blank leaves the stored value unchanged.
  storageProvider        StorageProviderType?
  storageBucket          String?
  storageRegion          String?
  storageEndpoint        String?
  storageAccessKeyId     String?
  storageSecretAccessKey String?
  storageConfiguredAt    DateTime?

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultTaxCode     TaxCode?        @relation(fields: [defaultTaxCodeId], references: [id], onDelete: SetNull)
  defaultPaymentTerm CommercialTerm? @relation(fields: [defaultPaymentTermId], references: [id], onDelete: SetNull)
}

model CompanyAddress {
  id          String      @id @default(cuid())
  companyId   String
  type        AddressType
  label       String?
  line1       String
  line2       String?
  city        String?
  province    String?
  postalCode  String?
  countryCode String      @default("ZA")
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
}

model Customer {
  id                    String            @id @default(cuid())
  companyId             String
  name                  String
  nameNormalized        String
  tradingName           String?
  accountCode           String?
  accountCodeNormalized String?
  registrationNumber    String?
  vatNumber             String?
  mainTelephone         String?
