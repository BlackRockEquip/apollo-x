// One flat status list shared across every job type, same pattern ModApp
// uses (JobStatus there) — which subset/order is valid for a given job is
// a pure function of JobType, computed in application code (see
// src/lib/jobs/ui.ts's flow-family step lists), not a stored column. This
// enum is additive-only relative to Apollo X's original 13 values (kept
// exactly as they were, including their names) — the new values below fill
// in the granularity ModApp's real-world use surfaced that Apollo X didn't
// have yet: a pre-strip queue state, outwork/paint stages, a payment-wait
// state distinct per flow, three dedicated field-service stages, two
// dedicated parts-supply stages, and the reversible "quoted, client
// declined, returned unrepaired" off-ramp.
enum JobStatus {
  DRAFT
  TO_BE_COLLECTED
  TO_BE_RECEIVED
  // Queued for stripping, after receipt but before STRIPPING actually
  // starts — main workshop flow only.
  TO_STRIP
  STRIPPING
  QUOTE_IN_PROGRESS
  AWAITING_GO_AHEAD
  // Waiting on an external supplier/outwork task (e.g. machining,
  // sandblasting sent out) — main workshop flow only, distinct from
  // WAITING_FOR_PARTS (internal inventory).
  AWAIT_OUTWORK
  WAITING_FOR_PARTS
  ASSEMBLY
  TESTING
  // Paint / wrap finishing stage — main workshop flow only.
  TO_PAINT_WRAP
  TO_BE_DELIVERED
  // Delivered, payment still outstanding — main/parts-supply flows.
  // Field-service jobs use AWAIT_PAYMENT below instead (kept as a
  // separate value, matching ModApp's own flow-specific split).
  DELIVERED_AWAITING_PAYMENT
  COMPLETE
  CLOSED
  CANCELLED
  // Quoted, client declined and asked for the unit back unrepaired.
  // Deliberately not part of any flow's ordered step list (it can happen
  // from several earlier stages, most commonly AWAITING_GO_AHEAD, and
  // skips everything after it) — reversible back to AWAITING_GO_AHEAD if
  // the client changes their mind. Main workshop flow only.
  RETURNED_UNREPAIRED

  // --- Field service flow only ---
  TO_ATTEND
  ON_ROUTE
  IN_PROGRESS
  AWAIT_PAYMENT

  // --- Parts supply flow only (alongside the shared TO_BE_RECEIVED /
  // TO_BE_DELIVERED / DELIVERED_AWAITING_PAYMENT / COMPLETE above) ---
  RECEIVED
  INSPECTING
}

enum JobActivityType {
  JOB_CREATED
  JOB_REGISTERED
  STATUS_CHANGED
  JOB_CLOSED
  JOB_REOPENED
  JOB_RETURNED_UNREPAIRED
  PART_ADDED
  PART_REMOVED
  PART_RESERVED
  RESERVATION_RELEASED
  PART_ISSUED
  PART_RETURNED
  KIT_APPLIED
  PART_LINE_RECEIVED
  PART_LINE_RECEIVED_UNDONE
  PART_LINE_ORDER_UPDATED
  OUTWORK_SENT
  OUTWORK_RECEIVED
  OUTWORK_RECEIVED_UNDONE
  OUTWORK_EDITED
  OUTWORK_DELETED
  RFQ_REQUESTED
  RFQ_REQUEST_REMOVED
  RFQ_QUOTE_RECORDED
  RFQ_PREFERRED_SUPPLIER_SET
  PEX_STOCK_TRANSFERRED
  PEX_STOCK_LINKED
  PEX_STOCK_UNLINKED
  PEX_RETURN_AUTO_CREATED
  PEX_RETURN_REGISTERED
  PEX_RETURN_RECEIVED
  PEX_RETURN_RELINKED
  PEX_SUPPLY_CANCELLED
  PEX_RETURN_CLOSED_WITHOUT_CORE
  PEX_STOCK_STATUS_CHANGED
  NOTE_ADDED
  FIELD_SERVICE_UPDATED
  WARRANTY_UPDATED
  // Chase email sent to a supplier for outstanding ordered-but-not-yet-
  // received parts — new 2026-09-09, mirrors ModApp's separate "Parts
  // follow-up" feature (src/lib/jobs/parts-followup.ts).
  PARTS_FOLLOWUP_SENT
  // New 2026-09-09 with the PexRecord full-replace (see PexRecord's own
  // comment) — mirrors ModApp's own PEX audit action names exactly
  // (PEX_RETURN_LINKED/PEX_RETURN_UNLINKED/PEX_UNIT_SCRAPPED/
  // JOB_ALLOCATED_TO_PEX_INVENTORY), used by getPexRecordHistory's
  // allow-list the same way ModApp's PEX_UNIT_HISTORY_ACTIONS is. The 10
  // PEX_STOCK_*/PEX_RETURN_*/PEX_SUPPLY_* values above this comment belong
  // to the retired PexStockUnit/PexSupplyLink model and are left in place,
  // unused, rather than removed — same "never touch existing rows"
  // convention as PARTS_FOLLOWUP_SENT above and the Parts list/Outwork
  // swap before it. A PEX_RETURN job's own status-change history needs no
  // new value — STATUS_CHANGED above already covers it, exactly like
  // ModApp relies on its own generic JOB_STATUS_CHANGED for the same
  // purpose.
  PEX_RETURN_LINKED
  PEX_RETURN_UNLINKED
  PEX_UNIT_SCRAPPED
  PEX_UNIT_ALLOCATED_TO_INVENTORY
  // Job attachments — new 2026-09-14 (see JobAttachment's own comment).
  ATTACHMENT_UPLOADED
  ATTACHMENT_DELETED
}

// Full replace (2026-09-09) of the old PexStockUnit/PexSupplyLink pair,
// at the user's explicit request, to match ModApp's simpler single-record
// PexRecord model exactly — one mutable row per supply/return cycle rather
// than a separately-tracked stock unit + link. See PexRecord below and
// src/lib/pex/service.ts for the full behavior this drives.
//
// AWAIT_CORE added 2026-09-10, at the user's direct request — a deliberate
// departure from strict ModApp parity above. A PEX Supply job's
// deliveryDate is a plain form field, independent of the job's own status
// stepper, so a unit could be delivered (deliveryDate set) while its
// PexRecord still showed TO_BE_DELIVERED indefinitely, right up until a
// return job got linked. AWAIT_CORE fills that gap: once delivered but
// before a return job exists, the record now reads "awaiting core" (the
// customer's old/broken unit still owed back), not "to be delivered". See
// syncPexAwaitCoreFromDeliveryDate in src/lib/pex/service.ts.
enum PexStatus {
  TO_BE_DELIVERED
  AWAIT_CORE
  OUTSTANDING
  RECEIVED
  IN_REPAIR
  COMPLETED
  SCRAPPED
}

enum JobWarrantyStatus {
  PENDING
  GRANTED
  DECLINED
}

enum PartLineStatus {
  PENDING
  IN_STOCK
  ON_ORDER
  // Some, but not all, of the ordered quantity has been received — the
  // rest is tracked as "outstanding" (quantity - receivedQuantity) and can
  // still be received in a later click, rather than the line being stuck
  // once any amount at all comes in.
  PARTIALLY_RECEIVED
  RECEIVED
}

enum OutworkStatus {
  SENT_OUT
  RECEIVED
}

// Per-company override for where a company's space-heavy files (attachments,
// exports, logos) get stored — added 2026-09-14 per
// claude/decision-storage-architecture-render-plus-object-storage.md. A
// company with no storageProvider set (the default) uses the platform-wide
// default bucket configured via STORAGE_* env vars — see
// src/lib/storage/index.ts. This governs file storage ONLY; core tenant
// data (Job/Customer/Inventory/etc.) always stays in the single shared
// Postgres, companyId-scoped, as already designed — per-tenant database
// sharding is a deliberately separate, much larger decision (see the
// decision doc's own reasoning) and is not what this enum is for.
enum StorageProviderType {
  R2
  B2
  S3_COMPATIBLE
}

// Every attachment/file this platform stores now goes through one generic
// model rather than a one-off Bytes column per feature (CompanySettings
// logo, JobRfqQuote, JobAttachment, SupportTicketAttachment all did this
// separately before). COMPANY_LOGO is the first owner type actually wired
// through this path (see company-settings-service.ts) — the others still
// use their own inline Bytes columns for now and are expected to migrate
// to this model feature-by-feature; see the decision doc for the plan.
enum AttachmentOwnerType {
  JOB
  RFQ_QUOTE
  SUPPORT_TICKET
  COMPANY_LOGO
  GENERAL_RFQ
}

// PENDING exists for a future direct-to-bucket presigned-upload flow (the
// object write and the DB row aren't in the same transaction, so a status
// column plus a sweep job is the standard pattern — see the decision doc's
// "Transactional integrity" open question). The current upload path writes
// the object then creates the row as COMMITTED in one server-side call, so
// PENDING rows shouldn't normally occur yet; ORPHANED is for a future sweep
// job (not yet built) to mark a COMMITTED row whose object turned out
// missing.
enum AttachmentStatus {
  PENDING
  COMMITTED
  ORPHANED
}

model UserIdentity {
  id             String   @id @default(cuid())
  email          String   @unique
  displayName    String
  passwordHash   String
  active         Boolean  @default(true)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships         CompanyMembership[]
  platformAssignments PlatformRoleAssignment[]
  sessions            UserSession[]
  initiatedSupport    PlatformSupportAccess[]  @relation("SupportInitiator")
  endedSupport        PlatformSupportAccess[]  @relation("SupportEnder")
  auditEvents         AuditEvent[]
  stockMovements      StockMovement[]          @relation("StockMovementActor")
  stockReservations   StockReservation[]       @relation("StockReservationActor")
  stockReleases       StockReservation[]       @relation("StockReservationReleaser")
  stockCountsCounted  StockCount[]             @relation("StockCountCounter")
  stockCountsApproved StockCount[]             @relation("StockCountApprover")
  jobsCreated         Job[]                    @relation("JobCreatedBy")
  jobsUpdated         Job[]                    @relation("JobUpdatedBy")
  jobsClosed          Job[]                    @relation("JobClosedBy")
  jobsStripAssigned   Job[]                    @relation("JobStripMechanic")
  jobsBuildAssigned   Job[]                    @relation("JobBuildMechanic")
  jobKitsCreated      JobKit[]
  jobNotes            JobNote[]                @relation("JobNoteAuthor")
  jobActivities       JobActivity[]            @relation("JobActivityActor")
  pexRecordsCreated   PexRecord[]              @relation("PexRecordCreatedBy")
  pexRecordsUpdated   PexRecord[]              @relation("PexRecordUpdatedBy")
  jobPartLinesCreated JobPartLine[]            @relation("JobPartLineCreatedBy")
  jobPartLinesUpdated JobPartLine[]            @relation("JobPartLineUpdatedBy")
  pickSlipsCreated    PickSlip[]               @relation("PickSlipCreatedBy")
  outworkItemsCreated OutworkItem[]            @relation("OutworkItemCreatedBy")
  outworkItemsUpdated OutworkItem[]            @relation("OutworkItemUpdatedBy")
  rfqRequestsCreated  JobRfqRequest[]          @relation("JobRfqRequestCreatedBy")
  rfqRequestsUpdated  JobRfqRequest[]          @relation("JobRfqRequestUpdatedBy")
  rfqQuotesCreated    JobRfqQuote[]            @relation("JobRfqQuoteCreatedBy")
  // General RFQs — added 2026-09-14 alongside the Suppliers screen's
  // Outwork/RFQ tabs, for an RFQ raised with no job at all (see
  // GeneralRfqRequest below).
  generalRfqsCreated  GeneralRfqRequest[]      @relation("GeneralRfqRequestCreatedBy")
  generalRfqsUpdated  GeneralRfqRequest[]      @relation("GeneralRfqRequestUpdatedBy")
  // Job attachments — added 2026-09-14 at the user's request ("Attachments
  // to be able to download via job view, have a attachments section,
  // view/delete"). Stored inline (see JobAttachment below), same pattern
  // as JobRfqQuote/SupportTicketAttachment — real object storage is
  // deferred (see decision-storage-architecture doc).
  jobAttachmentsCreated JobAttachment[]        @relation("JobAttachmentCreatedBy")
  moduleCatalogCreated ModuleCatalogEntry[]    @relation("ModuleCatalogCreatedBy")
  ticketsReported      SupportTicket[]         @relation("TicketReportedBy")
  ticketsAssigned      SupportTicket[]         @relation("TicketAssignedSupport")
  ticketMessages       SupportTicketMessage[]  @relation("TicketMessageAuthor")
  ticketEvents         SupportTicketEvent[]    @relation("TicketEventActor")
  ticketAttachmentsUploaded SupportTicketAttachment[] @relation("TicketAttachmentUploadedBy")
  dashboardConfigs     UserDashboardConfig[]
  tableColumnConfigs   UserTableColumns[]
  // Generic object-storage-backed attachments — added 2026-09-14, see
  // Attachment model below.
  attachmentsUploaded  Attachment[]            @relation("AttachmentUploadedBy")
}

