  @@index([companyId, machineMake])
  @@index([companyId, machineModel])
  @@index([companyId, componentType])
}

model JobKitLine {
  id              String    @id @default(cuid())
  companyId       String
  jobKitId        String
  partId          String
  quantityDefault Decimal   @db.Decimal(19, 4)
  notes           String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobKit          JobKit    @relation(fields: [jobKitId], references: [id], onDelete: Cascade)
  part            Part      @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([jobKitId, partId])
  @@unique([id, companyId])
  @@index([companyId, jobKitId])
  @@index([companyId, partId])
