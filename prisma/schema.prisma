// Hybrid job-type model (see the platform merge plan doc): JobType stays a
// fixed enum because it drives real behavior (which status-flow family a
// job follows, which ModuleKey gates it — see the flow-family logic in
// src/lib/jobs/ui.ts) — that's deliberately NOT customizable. What IS
// customizable, matching ModApp's per-company JobTypeConfig, is the label a
// company sees and picks from: a JobTypePreset is a company's own named
// preset (e.g. "Sandblasting", "Hydraulic Rebuild") that declares which
// fixed JobType it behaves as. Selecting a preset in the UI sets Job.type
// to `behavesAs`; the preset's own label is just how it's shown and
// searched in that company's job-type picker.
model JobTypePreset {
  id        String   @id @default(cuid())
  companyId String
  key       String
  label     String
  behavesAs JobType
  active    Boolean  @default(true)
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId, active])
}

// Matches ModApp's PurchaseOrderStatus exactly (field parity pass, see the
// platform merge plan doc) — used on Job.purchaseOrderStatus below.
enum PurchaseOrderStatus {
  TBA
  AWAIT_PAYMENT
  PARTIALLY_PAID
  PAID
  NOT_APPLICABLE
}

// Matches ModApp's DeliveryType exactly — used for both legs of a job's
// transport (Job.deliveryType for the outbound/return leg,
// Job.receivingTransport for how the unit originally arrived).
enum DeliveryType {
  INTERNAL_BAKKIE
  INTERNAL_TRUCK
  INTERNAL_COURIER
  EXTERNAL_BAKKIE
  EXTERNAL_TRUCK
  EXTERNAL_COURIER
}

model Job {
  id                  String      @id @default(cuid())
  companyId           String
  jobNumber           String?     @unique
  draftNumber         String      @unique @default(cuid())
  status              JobStatus   @default(DRAFT)
  type                JobType
  customerId          String
  customerReference   String?
  customerPo          String?
  dateReceived        DateTime?
  machineMake         String?
  machineModel        String?
  machineSerial       String?
  component           String?
  componentType       String?
  componentSerial     String?
  componentPartNumber String?
  description         String?
  etaDate             DateTime?
  // Staff-only ETA a mechanic sets for their own planning, distinct from
  // the client-facing etaDate above — visible/editable only to
  // Company Admin / Manager (mirrors ModApp's canEditMechanicEta gate).
  mechanicEtaDate     DateTime?
  relationshipNotes   String?
  relatedJobId        String?
  stripMechanicId     String?
  buildMechanicId     String?
  closingOutcome      String?
  closingNote         String?
  closedAt            DateTime?
  closedById          String?
  createdById         String
  updatedById         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // --- Field-parity additions (matching ModApp's Job model) ---
  // Quote / sales-order / invoice / purchase-order references. Plain
  // string/date fields for now, same as ModApp — become proper foreign
  // keys once the Quotes/Sales Orders/Invoices modules (still unbuilt,
  // see ModuleKey) exist.
  quoteNumber          String?
  quoteDate            DateTime?
  salesOrderNumber     String?
  salesOrderDate       DateTime?
  invoiceNumber        String?
  invoiceDate          DateTime?
  purchaseOrderNumber  String?
  purchaseOrderDate    DateTime?
  purchaseOrderStatus  PurchaseOrderStatus @default(NOT_APPLICABLE)
  // Two independent transport legs — how the unit arrived vs. how it goes
  // back out — matching ModApp's separate receivingTransport/deliveryType.
  deliveryDate         DateTime?
  deliveryType         DeliveryType?
  receivingTransport   DeliveryType?
  // Field-service-only: how far the technician travelled to/from site.
  kmsTravelled         Int?
  paymentDateReceived  DateTime?
  // Ticked when no payment is required at all for this job (e.g. a
  // no-charge warranty repair) — lets a "payment received" guard be
  // satisfied without a real date, distinguishable from "not paid yet".
  paymentNotApplicable Boolean   @default(false)
  machineHours         Decimal?  @db.Decimal(19, 4)
  plantNumber          String?
  reportNumber         String?
  importTrackingNumber String?
  // Free-text link to a prior job number (e.g. a "ready to go" PEX unit
  // being redeployed) — kept as a plain field for traceability and for the
  // historical-data import. Also the actual mechanism PexRecord redeployment
  // tracking reads (see syncPexRedeployment in src/lib/pex/service.ts) —
  // this field IS the "assign to job" UI, matching ModApp exactly.
  previousJobNumber    String?
  salesRepresentative  String?

  // 2026-09-14 — WIP Excel auto-sync's per-field conflict protection ("if
  // changes on the system have been made, spreadsheet must not overwrite
  // them"). One flat JSON object, keyed by Job column name, holding the
  // value the sync engine itself last wrote for every field it treats as a
  // straight overwrite (dates, status, type, customerId, the "never guess"
  // enums, kmsTravelled/machineHours, previousJobNumber — see
  // OVERWRITE_FIELDS in src/lib/jobs/excel-sync.ts; the free-text fields it
  // already only appends to, never overwrites, aren't tracked here at all).
  // On each sync run, a field whose LIVE value no longer matches its entry
  // here is assumed to have been changed by a person in Apollo X since the
  // last sync and is left alone — its entry here is then deliberately left
  // stale (not refreshed to the live value), so protection persists on
  // every future run regardless of what the spreadsheet says, rather than
  // only holding for one cycle. Null/absent entirely for a job the sync
  // has never written to. Purely internal bookkeeping — never read or
  // written by anything user-facing, and never surfaced in the API/UI.
  excelSyncSnapshot   Json?

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  relatedJob          Job?          @relation("RelatedJob", fields: [relatedJobId], references: [id], onDelete: SetNull)
  relatedJobs         Job[]         @relation("RelatedJob")
  stripMechanic       UserIdentity? @relation("JobStripMechanic", fields: [stripMechanicId], references: [id], onDelete: SetNull)
  buildMechanic       UserIdentity? @relation("JobBuildMechanic", fields: [buildMechanicId], references: [id], onDelete: SetNull)
  createdBy           UserIdentity  @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           UserIdentity  @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  closedBy            UserIdentity? @relation("JobClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  components          JobComponent[]
  partLines           JobPartLine[]
  outworkItems        OutworkItem[]
  pickSlips           PickSlip[]
  rfqRequests         JobRfqRequest[]
  attachments         JobAttachment[]
  notes               JobNote[]
  activities          JobActivity[]
  fieldServiceReport  JobFieldServiceReport?
  warranty            JobWarranty?
  // Full replace (2026-09-09) of the old PexStockUnit/PexSupplyLink pair —
  // see PexRecord below. A job is linked to at most one PexRecord on each
  // of these three independent legs (it created via being the supply job,
  // being the return job, or by redeploying a "Ready to Go" unit through
  // its own "Previous job number" field — see syncPexRedeployment in
  // src/lib/pex/service.ts).
  pexAsSupply         PexRecord?              @relation("PexSupplyJob")
  pexAsReturn         PexRecord?              @relation("PexReturnJob")
  pexConsumedBy       PexRecord?              @relation("PexConsumedByJob")

  @@unique([id, companyId])
  @@index([companyId, status, createdAt])
  @@index([companyId, type, createdAt])
  @@index([companyId, customerId, createdAt])
}

model JobComponent {
  id                  String   @id @default(cuid())
  companyId           String
  jobId               String
  component           String
  componentType       String?
  componentSerial     String?
  componentPartNumber String?
  createdAt           DateTime @default(now())

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, jobId])
}

// Full replace (2026-09-09) of the old PexStockUnit/PexSupplyLink pair, at
// the user's explicit request -- "remove apollo version of pex ... replace
// entirely like modapp" -- matching ModApp's PexRecord model field-for-field
// (companyId/clientId->customerId renamed to Apollo's own vocabulary,
// otherwise the same shape) rather than Apollo X's previous normalized
// stock-unit + link design. One mutable row per supply/return cycle:
//  - Created the moment a PEX_SUPPLY job is created/becomes that type
//    (supplyJobId set, status TO_BE_DELIVERED, no returnJobId yet).
//  - Moves to AWAIT_CORE once the supply job's own deliveryDate gets set,
//    still with no returnJobId -- see syncPexAwaitCoreFromDeliveryDate.
//  - Gets its returnJobId + status (derived from the return job's own
//    current status, see attachReturnJobTx) + supplyDate once a return job
//    exists -- automatically when the supply job reaches COMPLETE, via the
//    manual "Create linked return job now" button, or by linking an
//    already-existing standalone PEX_RETURN job ("Link PEX return job").
//  - Once linked, a PEX_RETURN job has no separate PEX status control of
//    its own -- its own generic job-status stepper IS the PEX status, kept
//    in sync automatically (see JOB_STATUS_TO_PEX_STATUS in
//    src/lib/pex/service.ts) every time that job's status changes.
//  - consumedByJobId/consumedAt track redeployment: any job (of any type)
//    that types a completed return job's number into its own "Previous job
//    number" field marks that unit as used, dropping it out of PEX
//    Inventory's "Ready to Go" list -- see syncPexRedeployment.
//  - A completed job of ANY type can also be allocated straight to PEX
//    Inventory with no supply leg at all (supplyJobId left null) -- the job
//    itself becomes the "return" record.
// Deliberately has no storage-location tracking (ModApp's PexRecord
// doesn't either) -- a real loss of the granularity Apollo X's old
// PexStockUnit had, accepted here in favor of exact ModApp parity per the
// user's explicit "replace entirely" decision.
model PexRecord {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String?
  unitDescription String?
  supplyJobId     String?   @unique
  returnJobId     String?   @unique
  status          PexStatus @default(TO_BE_DELIVERED)
  supplyDate      DateTime?
  returnDate      DateTime?
  notes           String?
  consumedByJobId String?   @unique
  consumedAt      DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplyJob       Job?          @relation("PexSupplyJob", fields: [supplyJobId], references: [id], onDelete: Restrict)
  returnJob       Job?          @relation("PexReturnJob", fields: [returnJobId], references: [id], onDelete: Restrict)
  consumedByJob   Job?          @relation("PexConsumedByJob", fields: [consumedByJobId], references: [id], onDelete: SetNull)
  createdBy       UserIdentity? @relation("PexRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       UserIdentity? @relation("PexRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model JobKit {
  id             String       @id @default(cuid())
  companyId      String
  name           String
  nameNormalized String
  description    String?
  machineMake    String?
  machineModel   String?
  componentType  String?
  active         Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      UserIdentity? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines          JobKitLine[]

  @@unique([companyId, nameNormalized])
  @@unique([id, companyId])
  @@index([companyId, active])
  @@index([companyId, machineMake])
  @@index([companyId, machineModel])
  @@index([companyId, componentType])
}

model JobKitLine {
  id              String    @id @default(cuid())
  companyId       String
  jobKitId        String
  partId          String
  quantityDefault Decimal   @db.Decimal(19, 4)
  notes           String?
  operationalStatus StorageOperationalStatus @default(OPERATIONAL)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobKit          JobKit    @relation(fields: [jobKitId], references: [id], onDelete: Cascade)
  part            Part      @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([jobKitId, partId])
  @@unique([id, companyId])
  @@index([companyId, jobKitId])
  @@index([companyId, partId])
}

enum StorageOperationalStatus {
  OPERATIONAL
  INTERNAL_ONLY
}

// Replaces the old JobPartRequirement/JobPartAllocation/JobPartAllocationMovement
// reserve-issue-return workflow (removed 2026-09-09 at the user's request —
// "the parts required section in apollo should be removed and the parts
// list section in modapp should be added"). Mirrors ModApp's JobPartLine: a
// simple, directly-editable list of parts needed for a job — paste a list,
// track order number/supplier, mark quantities received — rather than a
// formal reserve/issue/return chain through the immutable inventory ledger.
// `partId` is an optional cross-check link to Apollo X's own Part catalog
// (set automatically when a pasted part number matches one on file, same as
// ModApp's inventoryItemId); `partNumber` itself stays free text so a line
// for a part not yet in the catalog can still be recorded.
model JobPartLine {
  id                    String          @id @default(cuid())
  companyId             String
  jobId                 String
  partNumber            String
  description           String?
  quantity              Decimal         @db.Decimal(19, 4)
  status                PartLineStatus  @default(PENDING)
  // How many have actually been confirmed received so far — a delivery
  // doesn't always match the ordered quantity exactly, and this
  // accumulates across multiple "mark received" clicks rather than
  // locking the line after the first partial delivery.
  receivedQuantity      Decimal?        @db.Decimal(19, 4)
  // Whatever status this line was in right before receiving started —
  // restored exactly by "Undo" if "Mark received" was clicked by mistake.
  previousStatus        PartLineStatus?
  orderNumber           String?
  orderedFromSupplierId String?
  orderedAt             DateTime?
  partId                String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                   Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part                  Part?           @relation(fields: [partId], references: [id], onDelete: SetNull)
  orderedFromSupplier    Supplier?      @relation("JobPartLineOrderedFromSupplier", fields: [orderedFromSupplierId], references: [id], onDelete: SetNull)
  createdBy              UserIdentity?  @relation("JobPartLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              UserIdentity?  @relation("JobPartLineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  rfqQuoteLines          JobRfqQuoteLine[]

  @@index([companyId, jobId])
  @@index([companyId, partId])
  @@index([companyId, orderedFromSupplierId])
}

// New — added 2026-09-14 at the user's explicit request ("create a picking
// slip, which can be allocated to a job, printed, saved") — mirrors
// ModApp's PickSlip model (a lightweight grouping record; the individual
// picked parts live on their own line rows) but adapted to Apollo X's
// multi-location stock model: ModApp's InventoryItem carries one flat
// quantity, so its PickSlip just tags JobPartLine rows directly. Apollo X's
// stock is companyId+partId+locationId-scoped (StockBalance), so a picked
// line needs its own row (PickSlipLine below) recording exactly which part,
// quantity and bin location were actually issued — the JobPartLine it also
// creates (status RECEIVED, mirroring "picked immediately from stock", vs.
// PENDING for anything backordered) stays the job's own parts-list record,
// same as every other way a JobPartLine gets created in this app.
//
// Creating a pick slip is real stock movement, not just a document: each
// picked line posts a real ISSUE StockMovement (referenceType "JOB") via
// the same issueStock/buildMovement machinery every other outbound stock
// change in this app uses — see createPickSlip in inventory/service.ts.
// A selection made entirely of backordered/out-of-stock parts still adds
// PENDING JobPartLine rows to the job, but creates no PickSlip at all
// (nothing was actually picked) — same "nullable pick slip" behavior
// ModApp's generatePickSlip has.
model PickSlip {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String
  createdById String?
  createdAt   DateTime @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy   UserIdentity? @relation("PickSlipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines       PickSlipLine[]

  @@index([companyId, jobId])
  @@index([companyId, createdAt])
}

// One row per part actually picked onto a given PickSlip. partNumber/
// description/binLocation are captured at pick time (not just joined live
// through partId/binLocationId) so a reprint from Picking Slip History
// still shows exactly what was on the slip even if the part is later
// renamed or its default bin location changes — same "snapshot the
// printable facts, keep the FK for traceability" approach JobPartLine
// already uses for partNumber/description alongside its own optional
// partId link.
model PickSlipLine {
  id            String   @id @default(cuid())
  pickSlipId    String
  partId        String
  partNumber    String
  description   String
  binLocationId String?
  quantity      Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  pickSlip      PickSlip         @relation(fields: [pickSlipId], references: [id], onDelete: Cascade)
  part          Part             @relation(fields: [partId], references: [id], onDelete: Restrict)
  binLocation   StorageLocation? @relation(fields: [binLocationId], references: [id], onDelete: SetNull)

  @@index([pickSlipId])
  @@index([partId])
}

// New — added 2026-09-09 alongside the JobPartLine change above, at the
// user's request ("The outwork section from modapp should also be added to
// apollo"). Mirrors ModApp's OutworkItem: components sent out to a supplier
// for outwork (machining, sandblasting, plating, etc.) and tracked until
// they come back. Deliberately simpler than ModApp's version — no
// printable delivery-note generation, since Apollo X doesn't have ModApp's
// document-branding/print-template subsystem yet.
model OutworkItem {
  id            String        @id @default(cuid())
  companyId     String
  jobId         String
  supplierId    String
  description   String
  quantity      Int           @default(1)
  status        OutworkStatus @default(SENT_OUT)
  dateSentOut   DateTime?
  dateReceived  DateTime?
  // Every line added together in one "Record outwork" submission shares
  // the same batchId (a fresh cuid generated per submission, not per
  // line) — added 2026-09-09 so the historical "View delivery note"
  // action can show the whole batch an item was sent with, not just that
  // one line. Nullable so pre-existing rows from before this field
  // existed still work (their delivery note just falls back to
  // showing themselves alone).
  batchId       String?
  // Free-text note per item — added 2026-09-10 at the user's request ("a
  // note field next to each item sent out"). Set/edited via the same
  // outwork edit action as description/quantity/etc; not required.
  notes         String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation("OutworkItemSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     UserIdentity? @relation("OutworkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     UserIdentity? @relation("OutworkItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@index([companyId, batchId])
}

// ----------------------------------------------------------------------------
// RFQ (request for quote) — new, added 2026-09-09 at the user's request
// ("add the RFQ from suppliers section of ModApp"). Mirrors ModApp's
// RfqRequest/RfqQuote/RfqQuoteLine: request pricing from one or more
// suppliers for a job's parts list, record what each supplier quoted, and
// compare their prices side by side per part line.
//
// Deliberately simplified from ModApp's version: Apollo X has no outbound
// email infrastructure (no SMTP/nodemailer anywhere in this codebase), so
// there is no PENDING/SENT/FAILED send cycle here — "requesting" a quote
// just records that this supplier has been added to the job's comparison
// list (the same real-world action as ModApp's RfqStatus.SKIPPED path, used
// there for suppliers who quote by phone or in person rather than email).
// The user still gets/records pricing outside the system (phone, email,
// a supplier portal) and enters it here to compare. A fresh upload doesn't
// attempt to guess prices from the file's contents either, for the same
// "no extraction infrastructure yet" reason the Parts list paste box has no
// spreadsheet extraction — prices are entered by hand into an editable
// table, same end result, just without ModApp's best-effort auto-guess.
// ----------------------------------------------------------------------------

enum RfqRequestStatus {
  // Legacy value from before real email sending existed — a request added
  // with no send attempt at all. Kept (not removed) so any existing rows
  // stay valid; new "add without emailing" requests use SKIPPED instead
  // (see requestRfqFromSupplier in rfq/service.ts).
  REQUESTED
  // A real RFQ email was sent successfully.
  SENT
  // A real RFQ email was attempted and failed — see JobRfqRequest.lastSendError.
  FAILED
  // Added to the comparison list on purpose with no email ever attempted —
  // for suppliers who quote by phone/in person. Mirrors ModApp's
  // RfqStatus.SKIPPED.
  SKIPPED
  QUOTED
}

model JobRfqRequest {
  id           String            @id @default(cuid())
  companyId    String
  jobId        String
  supplierId   String
  // Snapshot of the job's parts list at request time, so the record stays
  // accurate even if the parts list changes afterwards — same purpose as
  // ModApp's RfqRequest.partsSummary.
  partsSummary String
  status       RfqRequestStatus  @default(SKIPPED)
  // Set when status is FAILED — the error message from the last send
  // attempt, shown in the RFQ panel so a retry isn't a total guess.
  lastSendError String?
  // Optional file attached when THIS RFQ is sent out (a drawing, spec
  // sheet or photo for the supplier) — added 2026-09-14 at the user's
  // request. Distinct from JobRfqQuote.data below, which is the
  // supplier's quote file coming back in the other direction. Inline
  // Bytes, same convention as JobRfqQuote/JobAttachment; excluded from
  // the job-detail query's default selection (see jobs/service.ts) so
  // the raw bytes are only ever fetched by the dedicated download route.
  attachmentFileName  String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  attachmentData      Bytes?
  requestedAt  DateTime          @default(now())
  createdById  String?
  updatedById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  supplier     Supplier          @relation("JobRfqRequestSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    UserIdentity?     @relation("JobRfqRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    UserIdentity?     @relation("JobRfqRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  quote        JobRfqQuote?

  // One active request per supplier per job — re-requesting refreshes the
  // parts summary/timestamp on the same row rather than piling up
  // duplicates (ModApp allows repeat RfqRequest rows per supplier since
  // each one is also an email-send attempt; without a send cycle here
  // there's nothing distinct about a second "request" from the same
  // supplier on the same job).
  @@unique([jobId, supplierId])
  @@index([companyId, jobId])
  @@index([companyId, supplierId])
}

// The supplier's quotation — an optional file for reference (stored inline
// as bytes, same pattern as SupportTicketAttachment; Apollo X has no
// separate Attachment model) plus free-text notes. The actual prices used
// for comparison live in JobRfqQuoteLine below, entered by hand.
model JobRfqQuote {
  id            String        @id @default(cuid())
  rfqRequestId  String        @unique
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  data          Bytes?
  notes         String?
  receivedAt    DateTime      @default(now())
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rfqRequest    JobRfqRequest @relation(fields: [rfqRequestId], references: [id], onDelete: Cascade)
  createdBy     UserIdentity? @relation("JobRfqQuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines         JobRfqQuoteLine[]
}

model JobRfqQuoteLine {
  id         String      @id @default(cuid())
  rfqQuoteId String
  partLineId String
  unitPrice  Decimal?    @db.Decimal(19, 4)
  // A supplier's quote sometimes leaves a part out entirely (they don't
  // stock it) — tracked separately from "no price entered yet" so the
  // comparison table can show "not quoted" instead of a misleading blank.
  available  Boolean     @default(true)
  notes      String?
  // Manually chosen as "buy this part from this supplier" in the
  // comparison table — independent of (and doesn't have to agree with) the
  // automatic cheapest-price highlight. At most one JobRfqQuoteLine per
  // partLineId across a job's suppliers should ever have this set —
  // enforced in code (setPreferredQuoteLine in rfq/service.ts clears any
  // other supplier's flag for the same part first), same as ModApp.
  preferred  Boolean     @default(false)

  rfqQuote   JobRfqQuote @relation(fields: [rfqQuoteId], references: [id], onDelete: Cascade)
  partLine   JobPartLine @relation(fields: [partLineId], references: [id], onDelete: Cascade)

  @@unique([rfqQuoteId, partLineId])
}

// A "general" RFQ — added 2026-09-14 for the Suppliers screen's new RFQ tab
// ("Add RFQ" button that can link to a job but isn't required to). Every
// RFQ above (JobRfqRequest) is built around a specific job: it snapshots
// that job's parts list and its quote lines tie back to JobPartLine rows,
// so there's no way to represent an RFQ with no job in that model. This is
// deliberately a separate, simpler shape for that case — free-text
// parts/notes instead of a snapshot, a hand-entered outstanding quantity
// instead of derived part lines, and a three-state status
// (sent/received/skipped) instead of the full email-driven
// RfqRequestStatus lifecycle. The Suppliers > RFQ tab lists rows from both
// models side by side; when the "Add RFQ" button is used with a job
// selected, a normal JobRfqRequest is created instead (see rfq/service.ts)
// — this model exists purely for the job-less case.
enum GeneralRfqStatus {
  SENT
  RECEIVED
  SKIPPED
}

model GeneralRfqRequest {
  id                  String            @id @default(cuid())
  companyId           String
  supplierId          String
  // Free-text description of what's being quoted — there's no job parts
  // list to snapshot.
  partsDescription    String
  // "Parts outstanding" qty shown on the RFQ tab — hand-entered, since
  // there are no JobPartLine rows to derive it from.
  quantityOutstanding Int?
  status              GeneralRfqStatus  @default(SENT)
  notes                String?
  // Optional file attached when this job-less RFQ is sent out — same
  // purpose and convention as JobRfqRequest.attachmentData above. Added
  // 2026-09-14.
  attachmentFileName  String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  attachmentData      Bytes?
  createdById         String?
  updatedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier            Supplier          @relation("GeneralRfqRequestSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy           UserIdentity?     @relation("GeneralRfqRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           UserIdentity?     @relation("GeneralRfqRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, supplierId])
  @@index([companyId, status])
}

// Job attachments — added 2026-09-14 at the user's request ("Attachments to
// be able to download via job view, have a attachments section,
// view/delete ... Jobs are saved as Job number in a folder called Jobs with
// all attachments, parts lists created, etc"). Stored inline as bytes, same
// pattern as JobRfqQuote/SupportTicketAttachment/CompanySettings.logoData —
// per the user's explicit choice not to stand up real object storage yet
// (see decision-storage-architecture-render-plus-object-storage.md, still
// "Not yet implemented"). The "Jobs folder, organized by job number" framing
// is satisfied by this being scoped to `jobId` and shown on that job's own
// Attachments section — there's no literal filesystem folder, every job's
// documents (attachments here, plus its parts list / outwork / RFQs) are
// simply everything scoped to that job's id.
model JobAttachment {
  id          String        @id @default(cuid())
  companyId   String
  jobId       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  data        Bytes
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy   UserIdentity? @relation("JobAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, jobId])
}

model JobNote {
  id          String       @id @default(cuid())
  companyId   String
  jobId       String
  note        String
  createdById String
  createdAt   DateTime     @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy   UserIdentity @relation("JobNoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, createdAt])
}

model JobActivity {
  id          String          @id @default(cuid())
  companyId   String
  jobId       String
  type        JobActivityType
  description String
  metadata    Json?
  actorId     String?
  createdAt   DateTime        @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor       UserIdentity?   @relation("JobActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, jobId, createdAt])
}

model JobFieldServiceReport {
  id          String   @id @default(cuid())
  companyId   String
  jobId       String   @unique
  site        String?
  technician  String?
  vehicle     String?
  hours       Decimal? @db.Decimal(19, 4)
  report      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId])
}

model JobWarranty {
  id                     String            @id @default(cuid())
  companyId              String
  jobId                  String            @unique
  status                 JobWarrantyStatus
  notes                  String?
  historicalSourceStatus String?
  updatedById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                    Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId])
}

enum ModuleCatalogStatus {
  ACTIVE
  INACTIVE
  PLANNED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TicketMessageKind {
  REPLY
  INTERNAL_NOTE
}

model ModuleCatalogEntry {
  id                  String              @id @default(cuid())
  code                String              @unique
  moduleKey           ModuleKey?          @unique
  name                String
  description         String?
  category            String
  status              ModuleCatalogStatus @default(ACTIVE)
  version             String              @default("1.0.0")
  icon                String?
  navGroup            String?
  navOrder            Int?
  route               String?
  assignableToTenants Boolean             @default(false)
  userAssignable      Boolean             @default(true)
  dependsOn           ModuleKey[]
  licensingMetadata   Json?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  createdBy UserIdentity? @relation("ModuleCatalogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, status])
}

model PlatformSequence {
  key       String   @id
  nextValue BigInt   @default(1)
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id                String         @id @default(cuid())
  companyId         String
  ticketNumber      String         @unique
  subject           String
  description       String
  category          String?
  priority          TicketPriority @default(NORMAL)
  status            TicketStatus   @default(OPEN)
  moduleKey         ModuleKey?
  pageRoute         String?
  userAgent         String?
  appVersion        String?
  reportedById      String
  assignedSupportId String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reportedBy      UserIdentity  @relation("TicketReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedSupport UserIdentity? @relation("TicketAssignedSupport", fields: [assignedSupportId], references: [id], onDelete: SetNull)

  messages    SupportTicketMessage[]
  events      SupportTicketEvent[]
  attachments SupportTicketAttachment[]

  @@index([companyId, status, priority])
  @@index([status, priority, createdAt])
  @@index([assignedSupportId, status])
  @@index([createdAt])
}

model SupportTicketMessage {
  id        String            @id @default(cuid())
  companyId String
  ticketId  String
  authorId  String
  kind      TicketMessageKind
  body      String
  createdAt DateTime          @default(now())

  ticket      SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      UserIdentity               @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
}

model SupportTicketEvent {
  id        String   @id @default(cuid())
  companyId String
  ticketId  String
  actorId   String?
  eventType String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  UserIdentity? @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SupportTicketAttachment {
  id           String   @id @default(cuid())
  companyId    String
  ticketId     String
  messageId    String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  ticket     SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy UserIdentity?         @relation("TicketAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

// Generic object-storage-backed attachment — added 2026-09-14 per
// claude/decision-storage-architecture-render-plus-object-storage.md,
// replacing the one-off-Bytes-column-per-feature pattern above (
// JobRfqQuote.data / JobAttachment.data / SupportTicketAttachment.data /
// CompanySettings.logoData) going forward. Only COMPANY_LOGO is actually
// wired through this model today (see company-settings-service.ts); the
// others keep their own inline Bytes columns until each is migrated
// feature-by-feature — see the decision doc's "migration of existing
// inline blobs" open question. ownerId is a plain scoped string, not a
// hard foreign key, the same way AuditEvent.entityId already works here —
// a real FK isn't possible across the different owner tables ownerType
// can point at.
model Attachment {
  id           String              @id @default(cuid())
  companyId    String
  ownerType    AttachmentOwnerType
  ownerId      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  // Which storage backend actually holds the bytes — "R2" | "B2" |
  // "S3_COMPATIBLE" | "LOCAL_DEV" (the last is the non-production
  // filesystem fallback in src/lib/storage/local-disk-backend.ts and is
  // never selected outside NODE_ENV !== "production" — see
  // src/lib/storage/index.ts). Plain String rather than
  // StorageProviderType so the dev-only backend doesn't need a place in
  // that enum.
  provider     String
  objectKey    String
  status       AttachmentStatus    @default(PENDING)
  notes        String?
  uploadedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy UserIdentity? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId, ownerType, ownerId])
  @@index([status])
}

model UserDashboardConfig {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// A user's own chosen set of visible columns for one customizable table —
// same shape/purpose as UserDashboardConfig above (a small owned-JSON
// preference row per {user, company}), just keyed by an extra `tableKey`
// so more than one table can use this same model instead of getting a
// dedicated one each (first consumer: the Jobs & WIP list, tableKey
// "jobs-wip" — see JOBS_WIP_TABLE_KEY in src/lib/jobs/wip-columns.ts).
model UserTableColumns {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  tableKey  String
  columns   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, tableKey])
}
