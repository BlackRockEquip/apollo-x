model JobPartRequirement {
  id                String   @id @default(cuid())
  companyId         String
  jobId             String
  partId            String
  quantityRequired  Decimal  @db.Decimal(19, 4)
  notes             String?
  etaDate           DateTime?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part              Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  allocations       JobPartAllocation[]

  @@index([companyId, jobId])
  @@index([companyId, partId])
}

model JobPartAllocation {
  id                 String                     @id @default(cuid())
  companyId          String
  jobId              String
  requirementId      String
  partId             String
  locationId         String
  stockReservationId String?
  quantityReserved   Decimal                    @default(0) @db.Decimal(19, 4)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job                Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requirement        JobPartRequirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  part               Part                       @relation(fields: [partId], references: [id], onDelete: Restrict)
  location           StorageLocation            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockReservation   StockReservation?          @relation(fields: [stockReservationId], references: [id], onDelete: SetNull)
  movements          JobPartAllocationMovement[]

  @@unique([requirementId, locationId, stockReservationId])
  @@index([companyId, jobId])
  @@index([companyId, requirementId])
  @@index([companyId, partId])
  @@index([companyId, locationId])
}

model JobPartAllocationMovement {
  id                String                         @id @default(cuid())
  companyId         String
  allocationId      String
  stockMovementId   String
  kind              JobPartAllocationMovementKind
  quantity          Decimal                        @db.Decimal(19, 4)
  returnDisposition JobPartReturnDisposition?
  createdAt         DateTime                       @default(now())

  company           Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  allocation        JobPartAllocation              @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  stockMovement     StockMovement                  @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([allocationId, stockMovementId, kind])
  @@index([companyId, allocationId])
  @@index([companyId, stockMovementId])
  @@index([companyId, kind])
}

model JobNote {
